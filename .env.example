# MongoDB — provide at hosting (e.g. mongodb+srv://user:pass@cluster.mongodb.net/checkmyphone)
MONGODB_URI=mongodb://127.0.0.1:27017/checkmyphone

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Razorpay — provide at hosting (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# App URL (used in reports / payments). In dev http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IMEI Lookup API (optional — add when you have a provider)
# IMEI_API_KEY=your-api-key-here
# IMEI_API_URL=https://api.example.com/imei

# Admin seed account
SEED_ADMIN_EMAIL=admin@checkmyphone.in
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Admin

# Technician seed account
SEED_TECH_EMAIL=tech@checkmyphone.in
SEED_TECH_PASSWORD=Tech@123
SEED_TECH_NAME=Raj Kumar
