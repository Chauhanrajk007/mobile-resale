# MongoDB Connection URI (Local or Atlas)
# Replace with your Atlas connection string (remember to add /checkmyphone before the ?)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/checkmyphone?retryWrites=true&w=majority

# JWT Token Secret (Type a secure random string for user authentication cookies)
JWT_SECRET=your_super_secret_session_token_generator_key_12345

# Razorpay API Keys (Obtained from Razorpay Dashboard -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SMTP Mail Server Configurations (Optional: if blank, email notifications will print to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=CheckMyPhone <noreply@checkmyphone.in>

# Application Base URL (Used for links inside email templates)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin account (created automatically on first DB connect if missing)
ADMIN_EMAIL=admin@checkmyphone.in
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin

# Technician account (created automatically on first DB connect if missing)
TECH_EMAIL=tech@checkmyphone.in
TECH_PASSWORD=Tech@123
TECH_NAME=Raj Kumar
